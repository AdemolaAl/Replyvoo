# Replyvoo settings. Copy to .env for local development; on Railway paste them into Variables.
# Lines marked (required) must be set in production. Everything else is optional.

NODE_ENV=development                 # production on the live server
APP_URL=http://localhost:3000        # (required) the final https:// address, no trailing slash
APP_SECRET=                          # (required) openssl rand -hex 32 — never change it after launch (encrypts tokens and keys)
TRUST_PROXY=true
TRUST_PROXY_HOPS=1                   # proxies in front of Replyvoo (each adds to X-Forwarded-For); the client IP is that many from the right
# DATABASE_PATH=./data/replyvoo.db   # Railway: leave unset (the Dockerfile uses /app/data on the volume)

ADMIN_EMAIL=                         # the first owner account, created on first boot
ADMIN_PASSWORD=

# Payments
PAYMENTS_DEMO=true                   # false in production
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
GATEVOO_API_KEY=
GATEVOO_WEBHOOK_SECRET=
# GATEVOO_API_URL=https://gatevoo.com
# Bachs (naira and African payments). Usually saved in Admin → Connections → Bachs instead.
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# AI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                      # optional backup AI
TRANSCRIBE_API_KEY=                  # optional: voice notes

# Email (resend, brevo or postmark; "log" prints emails to the console)
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=Replyvoo <hello@replyvoo.com>
MAIL_REPLY_TO=support@replyvoo.com

# VooSquare (Voo Connect). Usually saved in Admin → Connections → VooSquare instead.
VOO_BASE=                            # https://voosquare.com
VOO_CLIENT_ID=                       # vsc_…
VOO_CLIENT_SECRET=                   # vss_…
VOO_API_KEY=                         # vsk_…
VOO_SIGNAL_SECRET=                   # openssl rand -hex 32, make once, never change
# VOO_SERVICE_KEY=                   # optional: inbound key for VooSquare's staff sync
# VOO_CONNECT=off                    # switch every VooSquare feature off

# Joinvoo bridge: Joinvoo customers hand a bot's chats to Replyvoo ("Who answers chats in this bot?" in Joinvoo).
# Off until both are set. The secret must be the same value Joinvoo has as REPLYVOO_BRIDGE_SECRET (openssl rand -hex 32).
JOINVOO_URL=                         # Joinvoo's address for server-to-server calls, e.g. https://joinvoo.com
JOINVOO_BRIDGE_SECRET=               # shared secret, at least 24 characters, never change it casually
# JOINVOO_PUBLIC_URL=                # only if the public Joinvoo address differs from JOINVOO_URL
# JOINVOO_TIMEOUT_MS=10000
# JOINVOO_PUBLIC_URL must be the exact address people open Joinvoo on (e.g. https://joinvoo.com): the in-Joinvoo checkout window
# reports back only to that origin. Refunds of orders paid with Joinvoo credits are retried until Joinvoo confirms:
# JOINVOO_REFUND_RETRY_MS=300000

# Support desk (optional)
SUPPORT_TG_BOT_TOKEN=
SUPPORT_INBOUND_KEY=
SUPPORT_EMAIL_REPLY_TO=

# WhatsApp (Meta WhatsApp Business Platform). Normally saved in Admin → Connections → WhatsApp. See docs/WHATSAPP.md.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_CONFIG_ID=                  # Facebook Login for Business → Configurations (Embedded Signup)
WHATSAPP_VERIFY_TOKEN=               # long random text, same value in Meta → WhatsApp → Configuration
# META_GRAPH_VERSION=v26.0
# WHATSAPP_ENABLED=                  # empty = admin switch decides; true/false forces it
